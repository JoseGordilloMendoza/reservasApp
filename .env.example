# Copy to .env (ignored by git) and fill in.
# OAuth client id of the web app, from Google Cloud Console. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Email. With EMAIL_HOST empty, messages are printed in the backend console (development).
# In production use any SMTP provider's credentials.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Separa <no-responder@example.com>
# Address of the frontend, used for the links inside emails.
FRONTEND_URL=http://localhost:5173
